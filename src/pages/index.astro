---
import MainLayout from '../layouts/MainLayout.astro';

const res = await fetch('https://pokeapi.co/api/v2/pokemon?limit=50')
const data = await res.json()

const pokemonWithSprites = await Promise.all(
  data.results.map(async (pokemon) => {
    const res = await fetch(pokemon.url)
    const details = await res.json()

    return {
      name: pokemon.name,
      image: details.sprites.front_default
    }
  })
)
---

<MainLayout title="Kunstvangst">
	<section class="generator">
		<div>
			<h1>Hoe voel jij je <em>vandaag</em>?</h1>
			<p>Vang de kunst die je vandaag voelt!</p>
			<button>Vang een kaart!</button>
		</div>
	</section>

	<section>
		<h2>Kaarten</h2>
		<p>Hier zijn enkele kaarten die je hebt gevangen:</p>
		<ul>
			{pokemonWithSprites.map((pokemon) => (
			<li>
				<p>{pokemon.name}</p>
				<img src={pokemon.image} />
			</li>
			))}
		</ul>
	</section>
</MainLayout>

