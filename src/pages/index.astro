	<section class="collection-cards">
		<h2>Jouw <em>collectie</em></h2>
		<p>Hier zijn enkele kaarten die je hebt gevangen</p>
		<ul id="saved-cards"></ul>
		<button id="delete-cards">Verwijder alle kaarten</button>
	</section>
</MainLayout>

<script>
	// Ophalen van opgeslagen kaarten
	const cards = JSON.parse(localStorage.getItem('cards') ?? '[]');
	const list = document.getElementById('saved-cards');

	// Het formulier opsturen en gegevens opslaan in localStorage
	document.querySelector('form').addEventListener('submit', () => {
		const name = document.getElementById('name').value;
		const mood = document.getElementById('mood').value;
		localStorage.setItem('lastName', name);
		localStorage.setItem('lastMood', mood);

		// Zodat hij niet de foto en pokemon van de vorige kaart pakt als je meerdere kaarten vangt
		localStorage.removeItem('boothPhoto');
		localStorage.removeItem('lastPokemon');
	});

	// Kaarten weergeven en het opbouwen van de HTML voor elke kaart. Als er geen kaarten zijn, een lege state tonen.
	// https://developer.mozilla.org/en-US/docs/Web/API/Element/innerHTML
	if (cards.length === 0) {
	list.innerHTML = `<div><img class="empty-image" src="/images/jerry.png" alt="Geen kaarten" /><h3 class="empty">Geen kaarten</h3><h4 class="empty">Nog geen kaarten gevangen!</h4></div>`;
	} else {
	list.innerHTML = cards.map(card => `
		<li class="mood-${card.mood}" 
			style="cursor:pointer;" 
			onclick="window.location.href='/results?name=${encodeURIComponent(card.name)}&mood=${card.mood}&pokemon=${encodeURIComponent(card.pokemon?.name ?? '')}'">
			<div class="id-card-content">
			<div class="id-card-content-top">
			${'<span></span>'.repeat(8)}
			</div>
			<div class="id-card-content-bottom">
			<div class="id-card-content-bottom-img">
				${card.photo ? `<img src="${card.photo}" alt="Foto" style="width:100%; height:100%; object-fit:cover; border-radius:6px;" />` : ''}
				${card.pokemon ? `<img src="${card.pokemon.image}" alt="${card.pokemon.name}" class="pokemon-overlay" />` : ''}
			</div>
			<div class="id-card-content-bottom-info">
				<div>
				<p><em>Name.</em></p>
				<h2>${card.name}</h2>
				</div>
				${card.pokemon ? `
				<div class="pokemon-div">
					<img src="${card.pokemon.image}" alt="${card.pokemon.name}" />
					<p>${card.pokemon.name}</p>
				</div>
				` : ''}
				<div>
				<p><em>Mood.</em></p>
				<h2>${card.mood}</h2>
				</div>
			</div>
			</div>
			<div class="id-card-content-bottom-info-2">
			<p>&lt;&lt; trainer &lt;&lt;&lt;&lt; ${card.date} &lt;&lt;&lt;&lt;&lt;</p>
			</div>
		</div>
		</li>
	`).join('');
	}

	// Het verwijderen van alle kaarten en het tonen van de lege state dmv localStorage.clear() 
	const deleteButton = document.getElementById('delete-cards');
	deleteButton.addEventListener('click', removeCards);

	function removeCards() {
	localStorage.clear();
	list.innerHTML = `<div><img class="empty-image" src="/images/jerry.png" alt="Geen kaarten" /><h3 class="empty">Geen kaarten</h3><h4 class="empty">Nog geen kaarten gevangen!</h4></div>`;
	}
</script>

<style is:global>
	#saved-cards {
		display: flex;
		flex-wrap: wrap;
		gap: var(--size-2xl);
		list-style: none;
		padding: 0;
	}

	#saved-cards li{
		background-color: #f7b900;
		border: 2.5px solid #f7b900;
		box-shadow: 0 8px 0 #c99300, 0 12px 20px rgba(0, 0, 0, 0.25);
		border-radius: 20px;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0 1rem;
		font-family: 'DM Mono', monospace;
	}

	#saved-cards .id-card-content-top {
		display: flex;
		gap: 8px;
		height: 36px;
		align-items: center;
		justify-content: center;
	}

	#saved-cards .id-card-content-top span {
		display: block;
		width: 8px;
		height: 8px;
		background-color: #c99300;
		border-radius: 100%;
	}

	#saved-cards .id-card-content-bottom {
		width: 100%;
		background-color: var(--colour-background);
		border-radius: 10px;
		display: flex;
		gap: 1rem;
		padding: 0.75rem;
		min-height: 140px;
	}

	#saved-cards .id-card-content-bottom-img {
		aspect-ratio: 3 / 4;
		width: 8em;
		background-color: rgba(247, 169, 0, 0.4);
		border-radius: 6px;
		flex-shrink: 0;
	}

	#saved-cards .id-card-content-bottom-info {
		display: flex;
		flex-direction: column;
		gap: 6px;
		width: 8em;

		& div:nth-of-type(1),
		& div:nth-of-type(3) {
			align-self: start;
			text-align: left;
		}

		& div:nth-of-type(2) {
			display: flex;
			flex-direction: column;
			align-items: center;
		}
	}

	#saved-cards .id-card-content-bottom-info h2 {
		font-size: 0.95rem;
		font-weight: bold;
		color: #333333;
	}

	#saved-cards .id-card-content-bottom-info p {
		font-size: 0.8rem;
	}

	#saved-cards .id-card-content-bottom-info-2 {
		height: 36px;
		display: flex;
		align-items: center;
	}

	#saved-cards .id-card-content-bottom-info-2 p {
		font-size: 0.85rem;
		font-weight: bold;
		color: #c99300;
		font-family: 'DM Mono', monospace;
		margin: auto;
	}

	#saved-cards .pokemon-div {
		background-color: rgba(247, 169, 0, 0.4);
		border-radius: 4px;
		text-align: center;
		padding: 4px;
	}

	#saved-cards .pokemon-div img {
		width: 48px;
		height: 48px;
	}

	#saved-cards .id-card-content-bottom-img {
		position: relative;
		overflow: hidden;
	}

	#saved-cards .pokemon-overlay {
		position: absolute;
		bottom: -20px;
		right: -20px;
		width: 80%;
		height: auto;
		image-rendering: pixelated;
		filter: drop-shadow(2px 2px 4px rgba(0,0,0,0.5));
	}

	#delete-cards{
		margin-top: 4rem;
		text-decoration: none;
        font-size: var(--size-base);
        color: var(--colour-background);
        font-family: "DM Mono", serif;
        font-weight: lighter;
        padding: var(--size-xxs) var(--size-base);
        box-shadow: 3px 3px var(--colour-text);
        background-color: var(--colour-red);
        display: inline-block;
        transition: color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
	}

	h3.empty {
		font-size: var(--size-base);
		color: var(--colour-text);
		font-family: "DM Mono", serif;
		font-weight: bold;

	}
	h4.empty {
		font-size: var(--size-sm);
		color: var(--colour-text);
		font-family: "DM Mono", serif;
		opacity: 0.6;
	}

	.empty-image {
		width: 200px;
		margin-top: 2rem;
		margin-bottom: 1rem;
		/* background-color: rgb(182 70 28 / 0.5); */
		background-color: rgb(201 168 76 / 0.6);
		border-radius: 50%;
		padding: 2rem;
	}

	div:has(.empty) {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	#saved-cards li.mood-sad .id-card-content {
		background-color: #5378b4;
		border: 2.5px solid #5378b4;
	}

	#saved-cards li.mood-sad .id-card-content-top span {
		background-color: #1e3b6a;
	}

	#saved-cards li.mood-sad .id-card-content-bottom-info-2 p {
		color: #1e3b6a;
	}

	#saved-cards li.mood-sad {
		background-color: #5378b4;
		border: 2.5px solid #5378b4;
		box-shadow: 0 8px 0 #1e3b6a, 0 12px 20px rgba(0, 0, 0, 0.25);
	}
	#saved-cards li.mood-sad .id-card-content-bottom-img { background-color: rgb(30 59 106 / 0.4); }
	#saved-cards li.mood-sad .pokemon-div { background-color: rgba(30, 59, 106, 0.4); }


	/* angry */
	#saved-cards li.mood-angry {
		background-color: #B6461C;
		border: 2.5px solid #B6461C;
		box-shadow: 0 8px 0 #7a2e12, 0 12px 20px rgba(0, 0, 0, 0.25);
	}
	#saved-cards li.mood-angry .id-card-content-top span { background-color: #7a2e12; }
	#saved-cards li.mood-angry .id-card-content-bottom-info-2 p { color: #7a2e12; }
	#saved-cards li.mood-angry .id-card-content-bottom-img { background-color: rgb(122 46 18 / 0.4); }
	#saved-cards li.mood-angry .pokemon-div { background-color: rgba(122, 46, 18, 0.4); }

	/* unsure */
	#saved-cards li.mood-unsure {
		background-color: #b39ddb;
		border: 2.5px solid #b39ddb;
		box-shadow: 0 8px 0 #7e57c2, 0 12px 20px rgba(0, 0, 0, 0.25);
	}
	#saved-cards li.mood-unsure .id-card-content-top span { background-color: #7e57c2; }
	#saved-cards li.mood-unsure .id-card-content-bottom-info-2 p { color: #7e57c2; }
	#saved-cards li.mood-unsure .id-card-content-bottom-img { background-color: rgb(126 87 194 / 0.25); }
	#saved-cards li.mood-unsure .pokemon-div { background-color: rgba(126, 87, 194, 0.25); }


	/* content */
	#saved-cards li.mood-content {
		background-color: #f48fb1;
		border: 2.5px solid #f48fb1;
		box-shadow: 0 8px 0 #d4688a, 0 12px 20px rgba(0, 0, 0, 0.25);
	}
	#saved-cards li.mood-content .id-card-content-top span { background-color: #d4688a; }
	#saved-cards li.mood-content .id-card-content-bottom-info-2 p { color: #d4688a; }
	#saved-cards li.mood-content .id-card-content-bottom-img { background-color: rgb(212 104 138 / 0.25); }
	#saved-cards li.mood-content .pokemon-div { background-color: rgba(212, 104, 138, 0.25); }


	/* calm */
	#saved-cards li.mood-calm {
		background-color: #4caf6e;
		border: 2.5px solid #4caf6e;
		box-shadow: 0 8px 0 #2e7d4f, 0 12px 20px rgba(0, 0, 0, 0.25);
	}
	#saved-cards li.mood-calm .id-card-content-top span { background-color: #2e7d4f; }
	#saved-cards li.mood-calm .id-card-content-bottom-info-2 p { color: #2e7d4f; }
	#saved-cards li.mood-calm .id-card-content-bottom-img { background-color: rgb(46 125 79 / 0.3); }
	#saved-cards li.mood-calm .pokemon-div { background-color: rgba(46, 125, 79, 0.3); }


	@media (max-width: 600px) {
		#saved-cards {
			justify-content: center;
			gap: 0;
		}

		#saved-cards li {
			scale: 0.8;
			margin-top: -2rem;
		}

		#delete-cards{
			margin-top: 2rem;
			padding: var(--size-xxs) var(--size-sm);
			font-size: var(--size-sm);
		}
	}
</style>

