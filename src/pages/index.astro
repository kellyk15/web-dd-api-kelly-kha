		<p>Hier zijn enkele kaarten die je hebt gevangen</p>
		<ul>
			{pokemonWithSprites.map((pokemon) => (
			<li>
				<img src={pokemon.image} />
				<p>{pokemon.name}</p>
				{/* <p>{pokemon.types.join(", ")}</p> */}
