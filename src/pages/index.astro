	<section class="generator">
		<div>
			<h1>Hoe voel jij je <br> <em>vandaag</em>?</h1>
			<p>Vang de kunst die je vandaag voelt!</p>
		</div>
		
		<div>
			<form action="/results" method="GET">
				<fieldset>
					<legend></legend>
					<label for="name">JOUW NAAM
                        <input id="name" name="name" type="text" required>
                    </label>

					<label for="mood"> JOUW STEMMING
						<select name="mood" id="mood">
							<option value="neutral">- Kies een stemming -</option>
							<option value="happy">Blij</option>
							<option value="sad">Verdrietig</option>
							<option value="angry">Boos</option>
							<option value="unsure">Onzeker</option>
							<option value="content">Tevreden</option>
							<option value="calm">Rustig</option>
						</select>
					</label>
				</fieldset>
			
				<button id="catch-button">VANG EEN KAART</button>
			</form>
		</div>
	</section>

	<!-- <section class="collection">
