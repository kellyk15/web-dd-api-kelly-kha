---

<MainLayout title="Kunstvangst">
	<section class="photobooth-container">
        <div class="photobooth-header">
            <h1><em>Take a </em>photo</h1>
            <a href="/results" class="button-close button-class">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
            </a>
        </div>

        <div class="photobooth-div">
            <video class="player"></video>
            <div class="photobooth-buttons-container">
                <h1>FILTERS</h1>
                
                <div class="photobooth-buttons">
                    <button class="button-class">no filter</button>
                    <button class="button-class">grayscale</button>
                    <button class="button-class">sepia</button>
                    <button class="button-capture button-class">Neem een foto!</button>
                </div>
            </div>
        </div>

    </section>

    <div class="popup">
        <div class="popup-inner">
            <img class="popup-foto" src="" alt="Foto" />
            <div class="popup-buttons">
                <a href="#" class="popup-opnieuw button-class">Opnieuw</a>
                <a class="popup-gebruiken button-class">Gebruik foto</a>

                <!-- <button class="popup-gebruiken">Gebruik foto</button>
                <button class="popup-opnieuw">Opnieuw</button> -->
            </div>
        </div>
    </div>
</MainLayout>

<style>
    .popup {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 100;
        visibility: hidden;
        pointer-events: none;
    }

    .popup.actief {
        visibility: visible;
        pointer-events: all;
    }

    .popup-inner {
        background: var(--colour-background);
        /* border: 2px solid var(--colour-gold); */
        padding: 2rem;
        /* border-radius: 8px; */
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
    }

    .popup-inner img {
        max-width: 90vw;
        max-height: 80vh;
    }

    .player {
        transform: scaleX(-1);
        width: 50vw;
    }

    .button-close {
        height: 2.5rem;
        width: 2.5rem;
        cursor: pointer;
        padding: var(--size-xxs);

        & svg {
            width: 100%;
            height: 100%;
        }
    }
    
    .photobooth-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;

        font-weight: 500;

        & h1 {
            font-size: var(--size-4xl);
            color: var(--colour-gold);

            & em {
                color: var(--colour-red);
            }
        }
    }

    .photobooth-div {
        display: flex;
        width: 100%;
        justify-content: flex-start;
        gap: 2rem;

        & video {
            border-radius: 8px;
        }

        & .photobooth-buttons-container{
            display: flex;
            flex-direction: column;
            gap: 1rem;

            & h1 {
                font-size: var(--size-2xl);
                color: var(--colour-gold);
                font-weight: 500;
            }

            width: 100%;
        }
    }

    .popup-buttons {
        display: flex;
        gap: 1rem;

        & a{
            text-decoration: none;
            text-align: center;
            padding: var(--size-xs) var(--size-base);
            width: fit-content;
            cursor: pointer;
            

            &:nth-of-type(1) {
                background-color: var(--colour-gold);
            }
        }
    }

    div.photobooth-buttons {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;

        & button {
            box-shadow: none;
            border: 1px solid var(--colour-gold);
            background-color: transparent;
            color: var(--colour-gold);
            border-radius: 4px;
            transition: background-color 0.3s, color 0.3s, transform 0.3s;

            &:hover {
                background-color: var(--colour-gold);
                color: var(--colour-background);
                transform: scale(1.02);
            }

            &:last-of-type{
                grid-column: span 2;
                background-color: var(--colour-red);
                color: var(--colour-background);

                &:hover {
                    color: var(--colour-background);
                    transform: scale(1.02);
                }
            }
        }
    }

    @media (max-width: 600px){
        .photobooth-div {
            flex-direction: column;
            align-items: center;
            gap: 1rem;
            
            & video {
                width: 100%;
            }

            & .photobooth-buttons-container{
                align-items: start;
                text-align: center;
                width: 100%;
            }
        }

        .photobooth-container{
            padding: var(--size-2xl) var(--size-2xl);
        }
    }


</style>

<script>
    const video = document.querySelector(".player");
    const canvas = document.createElement("canvas");
    const takePhotoBtn = document.querySelector(".button-capture");
    const popup = document.querySelector(".popup");
    const popupFoto = document.querySelector(".popup-foto");
    const popupGebruiken = document.querySelector(".popup-gebruiken");
    const popupOpnieuw = document.querySelector(".popup-opnieuw");

    let mediastream = null;

    const filterBtns = document.querySelectorAll(".photobooth-buttons button:not(.button-capture)");

    // https://developer.mozilla.org/en-US/docs/Web/API/CanvasRenderingContext2D/filter
    filterBtns.forEach(btn => {
        btn.addEventListener("click", () => {
            const filterMap = {
                "no filter": "none",
                "grayscale": "grayscale(100%)",
                "sepia":     "sepia(100%)",
            };
            // het neemt expliciet de tekst van de knop om te bepalen welke filter er moet worden toegepast, als er geen match is wordt er "none" toegepast
            video.style.filter = filterMap[btn.textContent] ?? "none";
        });
    });

    function getVideo() {
        // het vragen van toegang tot de webcam en geen audio
        navigator.mediaDevices
            .getUserMedia({ video: true, audio: false })
            .then((localMediaStream) => {
                // het opslaan van de mediastream en dat koppelen aan <video> en dan video afspelen
                mediastream = localMediaStream; 
                video.srcObject = mediastream;
                video.play();
            })
            .catch((err) => {
                console.error("Webcam Access Denied", err);
                alert("Webcam Access Denied");
            });
    }
    getVideo();

    function takePhoto() {
        // https://developer.mozilla.org/en-US/docs/Web/API/Canvas_API
        // https://codepen.io/pandaa/pen/OJNVgYp?editors=0010
        const width = video.videoWidth || video.offsetWidth;
        const height = video.videoHeight || video.offsetHeight;
        canvas.width = width;
        canvas.height = height;

        const ctx = canvas.getContext("2d");
        ctx.filter = video.style.filter || "none";
        ctx.translate(width, 0);
        ctx.scale(-1, 1);
        ctx.drawImage(video, 0, 0, width, height);

        const data = canvas.toDataURL("image/jpeg");
        popupFoto.src = data;
        popup.classList.add("actief");

        // localStorage.setItem('boothPhoto', data);
    }

    takePhotoBtn.addEventListener("click", takePhoto); 

    popupGebruiken.addEventListener("click", () => {
        localStorage.setItem('boothPhoto', popupFoto.src);
        popup.classList.remove("actief");

        // Slaat de foto op in localStorage en sluit de popup
        const naam = localStorage.getItem('lastName');
        const stemming = localStorage.getItem('lastMood');
        const pokemon = localStorage.getItem('lastPokemon');
        
        // Haalt de eerder opgeslagen naam, stemming en pokemon op
        let url = '/results';
        const params = new URLSearchParams();
        if (naam) params.set('name', naam);
        if (stemming) params.set('mood', stemming);
        if (pokemon) params.set('pokemon', pokemon);
        if (params.toString()) url += '?' + params.toString();
        
        window.location.href = url;
    });

    popupOpnieuw.addEventListener("click", () => {
        popup.classList.remove("actief");
    });


    // Testen of we toegang hebben tot de webcam
    // console.log("asking");
    // navigator.mediaDevices
    // .getUserMedia({ audio: false, video: true })
    // .then((stream) => {
    //     console.log("ok");
    //     console.log(stream);
    // })
    // .catch((err) => {
    //     console.log(err);
    // });
</script>

