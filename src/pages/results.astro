            transition: border 0.3s, scale 0.3s;

            &:hover{
                border: 1px solid var(--colour-gold);
                scale: 1.05;
            }
        }
    } */

    & .pokemon-div {
        margin-top: var(--size-2xl);
        display: flex;
        justify-content: right;
        flex-direction: row;
        flex-wrap: wrap;
        
        gap: var(--size-base);
        align-items: center;

        & div{
            list-style: none;
            text-align: center;
            padding: var(--size-xs);
            border-radius: var(--size-xxs);
            border: 1px solid transparent;
    
            background-color: var(--colour-off-white);
            width: fit-content;
            transition: border 0.3s, scale 0.3s;

            &:hover{
