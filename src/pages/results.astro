---
export const prerender = false;
import MainLayout from '../layouts/MainLayout.astro';
import Card from '../components/Card.astro';

const moodToTypes = {
  sad:     ['water', 'ice'],
  happy:   ['electric', 'flying'],
  unsure:  ['ghost', 'psychic'],
  angry:   ['fire', 'fighting'],
  content: ['fairy', 'normal'],
  calm:    ['grass', 'ground'],
};

const res = await fetch('https://pokeapi.co/api/v2/pokemon?limit=151')
const data = await res.json()

const pokemonWithSprites = await Promise.all(
  data.results.map(async (pokemon) => {
    const res = await fetch(pokemon.url)
    const details = await res.json()

    return {
      name: pokemon.name,
      image: details.sprites.front_default,
      types: details.types.map(t => t.type.name),
      stats: details.stats.map(s => ({
        name: s.stat.name,
        value: s.base_stat
      }))
    }
  })
)

const name = Astro.url.searchParams.get('name') ?? 'Trainer';
const mood = Astro.url.searchParams.get('mood') ?? 'happy';
const today = new Date().toLocaleDateString('nl-NL');

const pokemonParam = Astro.url.searchParams.get('pokemon');

let moodPokemon;
if (pokemonParam) {
  moodPokemon = pokemonWithSprites.find(p => p.name === pokemonParam);
} 
else {
  moodPokemon = pokemonWithSprites
    .filter(pokemon => pokemon.types.some(type => moodToTypes[mood].includes(type)))
    .sort(() => Math.random() - 0.5)[0];
}

// het filtert alleen alleen de pokemon op de types en dan schudt de gefilterde lijst (sort) door elkaar en pakt [0] de eerste pokemon uit de lijst https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/sort

console.log('name:', name);
---

<MainLayout title="Kunstvangst">
  <Card name={name} mood={mood} moodPokemon={moodPokemon} date={today} photo={Astro.url.searchParams.get('photo') ?? ''} />
  
  <div class="results-container">
    <h1>Jouw <em>resultaten</em></h1>
      <section class="results">
          <p> Hallo, {name}! <br>Op basis van jouw stemming hebben we de volgende dingen voor je gevangen:</p>
          <!-- <ul>
              {pokemonWithSprites
                  .filter(pokemon => pokemon.types.some(type => moodToTypes['happy'].includes(type)))
                  .map(pokemon => (
                      <li>
                          <img src={pokemon.image} alt={pokemon.name} />
                          <p>{pokemon.name}</p>
                      </li>
                  ))}
          </ul> -->

          <!-- <ul>
              {pokemonWithSprites
                  .filter(pokemon => pokemon.types.some(type => moodToTypes['happy'].includes(type)))
                  .sort(() => Math.random() - 0.5)
                  .slice(0, 1)
                  .map(pokemon => (
                      <li>
                          <img src={pokemon.image} alt={pokemon.name} />
                          <p>{pokemon.name}</p>
                      </li>
                  ))}
          </ul> -->

          <div class="pokemon-div">
              {moodPokemon && (
                  <div>
                      <img src={moodPokemon.image} alt={moodPokemon.name} />
                      <p>{moodPokemon.name}</p>
                  </div>
              )}
          </div>

          <div class="stats">
            {moodPokemon.stats.map(stat => (
              <div class="stat-row">
                <span class="stat-name">{stat.name}</span>
                <div class="stat-bar">
                  <div class="stat-fill" style={`width: ${(stat.value / 255) * 100}%`}></div>
                </div>
                <span class="stat-value">{stat.value}</span>
              </div>
            ))}
          </div>
      </section>
  </div>
</MainLayout>

<style>
  .results-container {
    width: 50vw;
    margin-left: auto;
    padding: 1.5rem;

    display: flex;
    flex-direction: column;
    text-align: right;
    align-items: flex-end;
    justify-content: right;
  }

  h1 {
    font-size: var(--size-3xl);
    font-weight: 600;

    & em {
      color: var(--colour-red);
      }
  }

  .results {
    width: 100%;
    border-radius: 8px;

    /* & ul {
        margin-top: var(--size-2xl);
        display: flex;
        justify-content: right;
        flex-direction: row;
        flex-wrap: wrap;
        
        gap: var(--size-base);
        align-items: center;

        
        & li{
            list-style: none;
            text-align: center;
            padding: var(--size-xs);
            border-radius: var(--size-xxs);
            border: 1px solid transparent;
    
            background-color: var(--colour-off-white);
            width: fit-content;
            transition: border 0.3s, scale 0.3s;

            &:hover{
                border: 1px solid var(--colour-gold);
                scale: 1.05;
            }
        }
    } */

    & .pokemon-div {
        margin-top: var(--size-2xl);
        display: flex;
        justify-content: right;
        flex-direction: row;
        flex-wrap: wrap;
        
        gap: var(--size-base);
        align-items: center;

        & div{
            list-style: none;
            text-align: center;
            padding: var(--size-xs);
            border-radius: var(--size-xxs);
            border: 1px solid transparent;
    
            background-color: var(--colour-off-white);
            width: fit-content;
            transition: border 0.3s, scale 0.3s;

            &:hover{
                border: 1px solid var(--colour-gold);
                scale: 1.05;
            }
        }
    }
  }

  @media (max-width: 600px){
    .results-container {
        width: 100%;
        padding: 1rem;
        align-items: center;
        text-align: center;
        gap: 0;
        margin-top: -6em;
     }

     .results-container h1 {
        margin-top: -6em;
     }

     .results {
        & .pokemon-div {
            margin-top: var(--size-2xl);
            display: flex;
            justify-content: center;
            flex-direction: column;
            align-items: center;

            & div{
                list-style: none;
                text-align: center;
                padding: var(--size-xs);
                border-radius: var(--size-xxs);
                border: 1px solid transparent;
        
                background-color: var(--colour-off-white);
            }
          }
        }
  }

  .stats {
    margin-top: var(--size-base);
    display: flex;
    flex-direction: column;
    gap: var(--size-xs);
    width: 100%;
    background-color: var(--colour-off-white);
    padding: var(--size-2xl);
    border-radius: var(--size-xxs);
  }

  .stat-row {
    display: grid;
    grid-template-columns: 8rem 1fr 2rem;
    align-items: center;
    gap: var(--size-xs);
  }

  .stat-name {
    font-size: var(--size-sm);
    font-family: 'DM Mono', monospace;
    font-weight: 500;
    color: var(--colour-red);
  }

  .stat-bar {
    background-color: var(--colour-background);
    border-radius: 999px;
    height: 8px;
    overflow: hidden;
  }

  .stat-fill {
    height: 100%;
    background-color: var(--colour-gold);
    border-radius: 999px;
    transition: width 0.6s ease;
  }

  .stat-value {
    font-family: 'DM Mono', monospace;
    font-size: var(--size-sm);
    font-weight: 600;
    text-align: right;
  }
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const name = params.get('name') ?? localStorage.getItem('lastName');
  const mood = params.get('mood') ?? localStorage.getItem('lastMood');

  const pokemonImg = document.querySelector('.pokemon-div img');
  const pokemonName = document.querySelector('.pokemon-div p');

  console.log('name:', name);
  console.log('mood:', mood);
  console.log('boothPhoto aanwezig:', !!localStorage.getItem('boothPhoto'));
  console.log('cards:', JSON.parse(localStorage.getItem('cards') ?? '[]'));

  if (name && mood) {
    const cards = JSON.parse(localStorage.getItem('cards') ?? '[]');
    const today = new Date().toLocaleDateString('nl-NL');
    const photo = localStorage.getItem('boothPhoto') ?? null;

    console.log('photo:', photo ? 'aanwezig' : 'null');

    const existingIndex = cards.findIndex(c => c.name === name && c.mood === mood && c.date === today);
    console.log('existingIndex:', existingIndex);

    if (existingIndex === -1) {
      // nieuwe kaart aanmaken en toevoegen
      const newCard = {
        id: Date.now(),
        name,
        mood,
        pokemon: pokemonImg ? {
          image: pokemonImg.src,
          name: pokemonName?.textContent
        } : null,
        photo: photo,
        date: today
      };
      cards.push(newCard);
      console.log('nieuwe kaart opgeslagen met foto:', !!newCard.photo);
    } else {
      if (photo) {
        // alleen de foto updaten
        cards[existingIndex].photo = photo;
        console.log('bestaande kaart geupdate met foto');
      }
    }

    localStorage.setItem('cards', JSON.stringify(cards));

    // Pokemon in de URL zetten
    if (pokemonImg?.alt) {
      localStorage.setItem('lastPokemon', pokemonImg.alt);
      const url = new URL(window.location.href);
      url.searchParams.set('pokemon', pokemonImg.alt);
      window.history.replaceState({}, '', url);
    }
  }
</script>

