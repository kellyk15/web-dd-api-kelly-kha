---
export const prerender = false;
const { name = 'Trainer', moodPokemon, compact = false, date = '', mood = '' } = Astro.props;

// de card component ontvangt props van de index 
---

<!-- de kaart krijgt nu andere styling op basis van de stemming -->
<div class={`id-card-container ${compact ? 'compact' : ''} ${mood ? `mood-${mood}` : ''}`}>
    {!compact && <div class="id-card-touw"></div>}
    <div class="id-card-content">
        <div class="id-card-content-top">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
        </div>

        <div class="id-card-content-bottom">
            <div class="id-card-content-bottom-img">
                <img class="card-photo" src="" alt="Jouw foto" style="display:none;" />
                {moodPokemon && (
                    <img class="card-pokemon-overlay" src={moodPokemon.image} alt={moodPokemon.name} />
                )}
            </div>
            <div class="id-card-content-bottom-info">
                <div>
                    <p><em>Name.</em></p>
                    <h1>{name}</h1> 
                </div>
                <!-- <div>
                    <p><em>Trainer ID.</em></p>
                    <h2>123456789</h2>
                </div> -->
                <!-- <div>
                    <p><em>Pokemon.</em></p>
                    <h2>Snorlax</h2> 
                </div> -->
                <div class="pokemon-div">
                    {moodPokemon && (
                        <div>
                            <img src={moodPokemon.image} alt={moodPokemon.name} />
                            <p>{moodPokemon.name}</p>
                        </div>
                    )}
                </div>
                
                <!-- <div>
                    <p><em>Painting.</em></p>
                    <h2>Starry Night</h2> 
                </div> -->
                <!-- <div>
                    <p><em>Movie.</em></p>
                    <h2>Project hail mary</h2> 
                </div> -->

                <div>
                    <p><em>Mood.</em></p>
                    <h2>{mood}</h2> 
                </div>
            </div>
        </div>

        <div class="id-card-content-bottom-info-2">
            <p>&lt;&lt; trainer &lt;&lt;&lt;&lt; {date} &lt;&lt;&lt;&lt;&lt;</p>
        </div>
    </div>

    <!-- kaart wordt alleen laten zien als compact is false de naam en de mood wordt meegegeven -->
    {!compact && (
    <button>
        <a href={`/photobooth?name=${name}&mood=${mood}`}>Take Photo</a>
    </button>
    )}
</div>

<style>
