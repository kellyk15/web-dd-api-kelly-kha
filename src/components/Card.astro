    .id-card-container {
        z-index: 10;
        position: absolute;
        top: -70px;
        width: 600px; 
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        transform-origin: top center;
        animation: slidefromtop 1s both var(--ease-back-out);

        margin-left: 7.5rem; 

        & .id-card-touw {
            width: 75px; 
            height: 250px; 
            background-color: #c6491c;
            background: linear-gradient(128deg, rgba(214, 115, 79, 1) 0%, rgba(196, 73, 28, 1) 57%, rgba(182, 70, 28, 1) 95%);
            position: relative;

            &::after {
                content: '';
                position: absolute;
                bottom: -1px;
                left: 50%;
                transform: translateX(-50%);
                width: 95px;
                height: 35px;
                background: #cccccc;
                border-radius: 6px 6px 0 0;
                box-shadow: inset 0 -4px 8px rgba(0, 0, 0, 0.2);
            }
        }

        & .id-card-content {
            width: 90%;
            height: 100%;
            background-color: #f7b900;
            border: 2.5px solid #f7b900;
            box-shadow: 0 8px 0 #c99300, 0 12px 20px rgba(0, 0, 0, 0.25);
            border-radius: 20px; 
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem 0 1.5rem; 

            & .id-card-content-top {
                width: 100%;
                height: 50px; 
                display: flex;
                gap: 15px; 
                justify-content: center;
                align-items: center;

                & span {
                    display: block;
                    width: 10px;
                    height: 10px; 
                    background-color: #c99300;
                    border-radius: 100%;
                }
            }

            & .id-card-content-bottom {
                width: 100%;
                height: 300px; 
                background-color: var(--colour-background);
                border-radius: 10px; 
                display: flex;
                gap: var(--size-2xl); 
                padding: var(--size-2xl);

                & .id-card-content-bottom-img {
                    aspect-ratio: 3 / 4;
                    height: 100%;
                    background-color: rgba(247, 169, 0, 0.4);
                    border-radius: 10px; 
                    min-width: 45%;
                    position: relative; 
                    overflow: hidden;

                    & .card-photo {
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                        border-radius: 10px;
                    }

                    & .card-pokemon-overlay {
                        position: absolute;
                        bottom: -20px;
                        right: -20px;
                        width: 80%;
                        height: auto;
                        filter: drop-shadow(2px 2px 4px rgba(0,0,0,0.5));
                    }
                }

                & .id-card-content-bottom-info {
                    display: flex;
                    justify-content: space-around;
                    flex-direction: column;
                    gap: 10px;
                    width: 100%;
                    font-family: 'DM Mono', monospace;

                    & h1 {
                        font-size: 1.2rem;
                        font-weight: bold;
                        color: #333333;
                    }

                    & h2 {
                        font-size: 1.2rem;
                        font-weight: 600;
                        color: #333333;
                    }

                    & p {
                        font-size: 1rem;
                    }
                }
                
            }
        }

        .id-card-content-bottom-info-2{
            height: 50px;
            display: flex;
            align-items: center;

            & p {
                font-size: 1.35rem;
                font-weight: bold;
                color: #c99300;
            }
        }
    }
    
    .id-card-container.compact {
        position: static;
        width: 240px;
        margin-left: 0;
        animation: none;
        top: auto;
    }

    .pokemon-div{
        background-color: rgba(247, 169, 0, 0.4);
        border-radius: 4px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: var(--size-xxs);

        & div p{
            color: var(--colour-text);
        }
    }

    a {
        margin-top: var(--size-4xl);
        text-decoration: none;
        font-size: var(--size-base);
        color: var(--colour-background);
        font-family: 'DM Mono', serif;
        font-weight: lighter;
        padding: var(--size-xxs) var(--size-base);
        box-shadow: 3px 3px var(--colour-text);

        background-color: var(--colour-red);
        display: inline-block;
        transition: color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;

        &:hover {
            transform: translate(2px, 2px);
            box-shadow: 0px 0px var(--colour-text);
        }
    }

    /* verschillende moods */
    .id-card-container {
        &.mood-angry {
            & .id-card-content {
                background-color: #B6461C;
                border: 2.5px solid #B6461C;
                box-shadow: 0 8px 0 #7a2e12, 0 12px 20px rgba(0, 0, 0, 0.25);
 
                & .id-card-content-top span {
                    background-color: #7a2e12;
                }
 
                & .id-card-content-bottom-info-2 p {
                    color: #7a2e12;
                }
 
                & .id-card-content-bottom {
                    & .id-card-content-bottom-img {
                        background-color: rgb(122 46 18 / 0.4);
                    }
                }
            }
 
            & .id-card-touw {
                background: linear-gradient(128deg,
                    rgba(214, 115, 79, 1) 0%,
                    rgba(182, 70, 28, 1) 57%,
                    rgba(122, 46, 18, 1) 95%
                );
            }
 
            & .pokemon-div {
                background-color: rgba(122, 46, 18, 0.4);
            }
        }
        &.mood-sad {
            & .id-card-content {
                background-color: #5378b4;
                border: 2.5px solid #5378b4;
                box-shadow: 0 8px 0 #1e3b6a, 0 12px 20px rgba(0, 0, 0, 0.25);

                & .id-card-content-top span {
                    background-color: #1e3b6a;
                }

                & .id-card-content-bottom-info-2 p {
                    color: #1e3b6a;
                }

                & .id-card-content-bottom{
                    & .id-card-content-bottom-img{
                        background-color: rgb(30 59 106 / 0.4);
                    }
                }
            }

            

            & .id-card-touw {
                background: linear-gradient(128deg,
                    rgba(100, 110, 120, 1) 0%,
                    rgba(60, 65, 75, 1) 31%,
                    rgba(25, 28, 35, 1) 95%
                );
            }

            & .pokemon-div{
                background-color: rgba(30, 59, 106, 0.4);
            }
        }

        &.mood-unsure {
            & .id-card-content {
                background-color: #b39ddb;
                border: 2.5px solid #b39ddb;
                box-shadow: 0 8px 0 #7e57c2, 0 12px 20px rgba(0, 0, 0, 0.25);
 
                & .id-card-content-top span {
                    background-color: #7e57c2;
                }
 
                & .id-card-content-bottom-info-2 p {
                    color: #7e57c2;
                }
 
                & .id-card-content-bottom {
                    & .id-card-content-bottom-img {
                        background-color: rgb(126 87 194 / 0.25);
                    }
                }
            }
 
            & .id-card-touw {
                background: linear-gradient(128deg,
                    rgba(206, 191, 240, 1) 0%,
                    rgba(179, 157, 219, 1) 57%,
                    rgba(149, 117, 205, 1) 95%
                );
            }
 
            & .pokemon-div {
                background-color: rgba(126, 87, 194, 0.25);
            }
        }
 
        &.mood-content {
            & .id-card-content {
                background-color: #f48fb1;
                border: 2.5px solid #f48fb1;
                box-shadow: 0 8px 0 #d4688a, 0 12px 20px rgba(0, 0, 0, 0.25);
 
                & .id-card-content-top span {
                    background-color: #d4688a;
                }
 
                & .id-card-content-bottom-info-2 p {
                    color: #d4688a;
                }
 
                & .id-card-content-bottom {
                    & .id-card-content-bottom-img {
                        background-color: rgb(212 104 138 / 0.25);
                    }
                }
            }
 
            & .id-card-touw {
                background: linear-gradient(128deg,
                    rgba(252, 200, 220, 1) 0%,
                    rgba(244, 143, 177, 1) 57%,
                    rgba(212, 104, 138, 1) 95%
                );
            }
 
            & .pokemon-div {
                background-color: rgba(212, 104, 138, 0.25);
            }
        }
 
        &.mood-calm {
            & .id-card-content {
                background-color: #4caf6e;
                border: 2.5px solid #4caf6e;
                box-shadow: 0 8px 0 #2e7d4f, 0 12px 20px rgba(0, 0, 0, 0.25);
 
                & .id-card-content-top span {
                    background-color: #2e7d4f;
                }
 
                & .id-card-content-bottom-info-2 p {
                    color: #2e7d4f;
                }
 
                & .id-card-content-bottom {
                    & .id-card-content-bottom-img {
                        background-color: rgb(46 125 79 / 0.3);
                    }
                }
            }
 
            & .id-card-touw {
                background: linear-gradient(128deg,
                    rgba(100, 190, 130, 1) 0%,
                    rgba(60, 155, 90, 1) 57%,
                    rgba(30, 110, 60, 1) 95%
                );
            }
 
            & .pokemon-div {
                background-color: rgba(46, 125, 79, 0.3);
            }
        }
    }

    @media (max-width: 600px){
        .id-card-container {
            position: relative;
            scale: 0.5;
            margin: auto;
            left: -140px;
            top: 0px;
            animation: none;
            z-index: 0;

            & .id-card {
                padding: 1rem;
                gap: 0.5rem;

                & h2 {
                    font-size: var(--size-xl);
                }
            }

            & button{
                scale: 1.8;
            }

            & .id-card-touw{
                display: none;
            }
        }
    }

    @keyframes slidefromtop {
        0% {
            transform: translateX(-100%);
            rotate: 90deg;
        }
        100% {
            transform: translateX(0);
            rotate: 0deg;
        }
    }
</style>

<script>
    // https://stackoverflow.com/questions/22306397/how-to-get-the-browser-current-date
    // var vandaag = new Date().toLocaleDateString('nl-NL');
    // document.getElementById('datum').textContent = vandaag;

    // het opzoeken van de foto in localStorage en deze tonen op de kaart als deze er is
    const photo = localStorage.getItem('boothPhoto');
    const cardPhoto = document.querySelector('.card-photo');
    if (photo && cardPhoto) {
        cardPhoto.src = photo;
        cardPhoto.style.display = 'block';
    }
</script>